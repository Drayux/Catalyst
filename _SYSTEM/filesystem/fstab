# MOUNT POINTS

# <fs>		<mount>		<type>	<opts>				<dump/pass>
LABEL=BASE	/		btrfs	defaults,noatime,autodefrag	0 0		# BASE: /dev/nvme1n1p4 (always 0, 0 for btrfs!)
LABEL=TMP	/var/tmp	ext4	defaults,noatime,mode=1777	0 0		# TMP: /dev/nvme1n1p6
LABEL=HOME	/home		btrfs	defaults,noatime,autodefrag	0 0		# HOME: /dev/nvme1n1p5
LABEL=LIBRARY	/var/games	btrfs	defaults,noatime,autodefrag	0 0		# (steam) LIBRARY: /dev/nvme0n1p1 (entirety of second drive!)
UUID=31D7-9407	/boot		vfat	umask=0077,tz=UTC		0 2		# BOOT: /dev/nvme1n1p1

UUID=96825890-c0a5-47d3-a603-b3dbdd63561b	none	swap	sw	0 0		# SWAP: /dev/nvme1n1p2 (max 64GB)

# VIRTUALS

# <fs>		<mount>		<type>	<opts>				<dump/pass>
# tmpfs		/tmp		tmpfs	size=32G,mode=1777,noexec	0 0		# Keep /tmp fully in memory
tmpfs		/tmp		tmpfs	size=32G,mode=1777		0 0		# Keep /tmp fully in memory

