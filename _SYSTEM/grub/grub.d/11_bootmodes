#! /bin/sh
set -e


### LLM DISCLOSURE ###

# While I'd love for every line of my config to be hand-written and carefully
# placed, it was quickly becoming apparent that a trivial part of the process
# was growing way beyond scope. Thus, the majority of this logic is not my own.

# In essence, I thought that deferring the work to an LLM to dynamically
# generate menu entries in the "intended way" would be vastly preferable to
# introducing a static config that requires manual intervention at every kernel
# update.

# Of note, I've since put in great effort to merging this with that of 10_linux
# and 05_uki, so at this point, the LLM disclaimer may be somewhat obsolete.

### -------------- ###


# --- Identify any kernel version that seems to be installed ---
#     Searches the boot partition for a binary and matching ramfs image.

# Not preserved here, but from the original, initrd matched from a
# relatively major search, we just do a simple one.
# To use the original logic, I need to tweak the supplied path in order to
# parse dirname, $linux from OG is the full path found
find_initramfs() {
    local version="$1"
    local versioned="/boot/initramfs-${version}.img"
    local generic="/boot/initramfs.img"
    if [ -f "$versioned" ]; then
        echo "$versioned"
    elif [ -f "$generic" ]; then
		# Unversioned fallback -- dracut is not currently configured to do this
		# on my system, but it's a peace of mind to have
        echo "$generic"
    else
        echo ""
    fi
}

# TODO: This was originally make assuming I wasn't using a UKI, since I am,
# the only verification was skipped....it could stand to be revised (ensure
# valid version number, for example, probably refer to 10_linux here.)
declare -a VALID_VERSIONS=()
for kernel in /boot/vmlinuz-*; do
    [ -f "$kernel" ] || continue
    version="${kernel#/boot/vmlinuz-}"
    # [ -n "$(find_initramfs "$version")" ] || continue
    VALID_VERSIONS+=("$version")
done
# TODO: Verify, is an exit okay here?
[ "${#VALID_VERSIONS[@]}" -gt 0 ] || exit 0

# As an alternative to the above, below is the logic used by the original
# menu entry generator
# machine=`uname -m`
# case "x$machine" in
    # xi?86 | xx86_64)
	# list=
	# for i in /boot/vmlinuz-* /vmlinuz-* /boot/kernel-* ; do
	    # if grub_file_is_not_garbage "$i" ; then list="$list $i" ; fi
	# done ;;
    # *) 
	# list=
	# for i in /boot/vmlinuz-* /boot/vmlinux-* /vmlinuz-* /vmlinux-* /boot/kernel-* ; do
		# if grub_file_is_not_garbage "$i" ; then list="$list $i" ; fi
	# done ;;
# esac


# --- Prepare a sorted list of seemingliy valid kernel versions found ---
# 	  (ordered from oldest -> newest)

IFS=$'\n' SORTED=($(printf '%s\n' "${VALID_VERSIONS[@]}" | sort -V))
unset IFS
kernel_count="${#SORTED[@]}"
DEFAULT_VERSION="${SORTED[$((kernel_count - 1))]}"
OLDER_VERSIONS=("${SORTED[@]:0:$((kernel_count - 1))}")


# --- Prepare necessary environment-specific variables ---
# This much is taken directly from the original 10_linux

# /usr/share/grub/grub-mkconfig_lib
prefix="/usr"
exec_prefix="/usr"
datarootdir="/usr/share"
. "$pkgdatadir/grub-mkconfig_lib"

export TEXTDOMAIN=grub
export TEXTDOMAINDIR="${datarootdir}/locale"

BOOT_DEVICE="$(${grub_probe} --target=device /boot)"
BASE_CMDLINE="${GRUB_CMDLINE_LINUX} ${GRUB_CMDLINE_LINUX_DEFAULT}"
RECOVERY_CMDLINE="${GRUB_CMDLINE_LINUX_RECOVERY} ${GRUB_CMDLINE_LINUX}"

# Hard-coded version of name resolution
# (was general-purpose for any distro, no need to preserve the logic)
OS="Gentoo Linux"
CLASS="--class gentoo --class gnu-linux --class gnu --class os"

# Preserved, but likely not needed for my system: loop-AES arranges things so
# that /dev/loop/X can be our root device, but the initrds don't like that
case ${GRUB_DEVICE} in
  /dev/loop/*|/dev/loop[0-9])
    GRUB_DEVICE=`losetup ${GRUB_DEVICE} | sed -e "s/^[^(]*(\([^)]\+\)).*/\1/"`
  ;;
esac

# Original script sets these as fallbacks, my use case will always generate
# recovery mode and we do need partuuid for btrfs, so they're ignored here
# : ${GRUB_CMDLINE_LINUX_RECOVERY:=single}
# : ${GRUB_DISABLE_LINUX_PARTUUID=true}

# btrfs may reside on multiple devices. We cannot pass them as value of root= parameter
# and mounting btrfs requires user space scanning, so force UUID in this case.
if ( [ "x${GRUB_DEVICE_UUID}" = "x" ] && [ "x${GRUB_DEVICE_PARTUUID}" = "x" ] ) \
    || ( [ "x${GRUB_DISABLE_LINUX_UUID}" = "xtrue" ] \
	&& [ "x${GRUB_DISABLE_LINUX_PARTUUID}" = "xtrue" ] ) \
    || ( ! test -e "/dev/disk/by-uuid/${GRUB_DEVICE_UUID}" \
	&& ! test -e "/dev/disk/by-partuuid/${GRUB_DEVICE_PARTUUID}" ) \
    || ( test -e "${GRUB_DEVICE}" && uses_abstraction "${GRUB_DEVICE}" lvm ); then
  LINUX_ROOT_DEVICE=${GRUB_DEVICE}
elif [ "x${GRUB_DEVICE_UUID}" = "x" ] \
    || [ "x${GRUB_DISABLE_LINUX_UUID}" = "xtrue" ]; then
  LINUX_ROOT_DEVICE=PARTUUID=${GRUB_DEVICE_PARTUUID}
else
  LINUX_ROOT_DEVICE=UUID=${GRUB_DEVICE_UUID}
fi

case x"$GRUB_FS" in
    xbtrfs)
	rootsubvol="`make_system_path_relative_to_its_root /`"
	rootsubvol="${rootsubvol#/}"
	if [ "x${rootsubvol}" != x ]; then
	    GRUB_CMDLINE_LINUX="rootflags=subvol=${rootsubvol} ${GRUB_CMDLINE_LINUX}"
	fi;;
    xzfs)
	rpool=`${grub_probe} --device ${GRUB_DEVICE} --target=fs_label 2>/dev/null || zdb -l ${GRUB_DEVICE} | awk -F \' '/ name/ { print $2 }'`
	bootfs="`make_system_path_relative_to_its_root / | sed -e "s,@$,,"`"
	LINUX_ROOT_DEVICE="ZFS=${rpool}${bootfs%/}"
	;;
esac


# --- Create boot menu entries ---

# Emits the menu entry for a single kernel image
generate_boot_entries() {
    local version="$1"
    local indent="$2"
	local tab='	'
    local initramfs rel_kernel rel_initramfs title rw_flag mode root_uuid

	commandline="${BASE_CMDLINE}"
    initramfs="$(find_initramfs "$version")"
    rel_kernel="/vmlinuz-${version}"
    rel_initramfs="${initramfs#/boot}"
	root_uuid="${LINUX_ROOT_DEVICE}"

	# Note of skipped original logic. If there is no initrd, then the
	# root=UUID= / root=ZFS= can not work. My system always uses an initrd for
	# the overlay system to work, so it's been skipped.

	if [ "x$initramfs" = x ]; then
		if [ "x${GRUB_DEVICE_PARTUUID}" = "x" ] || [ "x${GRUB_DISABLE_LINUX_PARTUUID}" = "xtrue" ]; then
			root_uuid=${GRUB_DEVICE}
		else
			root_uuid=PARTUUID=${GRUB_DEVICE_PARTUUID}
		fi
	fi

	# TODO: Investigate the rw_flag, I'm not certain it is meaningful at this
	# point in the process
	# Also TODO: I wish to organize these into their own submenus to be a bit
	# more intuitive, but I'm not quite sure what that looks like yet. Maybe a
	# dedicated "options" for the maintenance operations?
    for mode in overlay live snapshot recovery commit; do
        case "$mode" in
            overlay)  title="Overlay Mode";            rw_flag="ro" ;;
            snapshot) title="Snapshot Mode";           rw_flag="ro" ;;
            live)     title="Live Mode";               rw_flag="rw" ;;
            commit)   title="Commit overlay and boot"; rw_flag="rw" ;;
			recovery)
				# TODO: Make recovery even more """recovery"""
				# Minimal loaded drivers, no udev...that sorta thing
				title="Recovery Mode (Live)";
				rw_flag="rw"
				commandline="${RECOVERY_CMDLINE}"
				;;
        esac

        echo "${indent}menuentry '${OS} -- ${title}' ${CLASS} {"

		### Taken directly from 10_linux
		# TODO: Merge the indentation with our own
		if [ "x$GRUB_GFXPAYLOAD_LINUX" = x ]; then
			echo "	load_video" | sed "s/^/$indent/"
			if grep -qx "CONFIG_FB_EFI=y" "${config}" 2> /dev/null \
					&& grep -qx "CONFIG_VT_HW_CONSOLE_BINDING=y" "${config}" 2> /dev/null; then
				echo '	if [ "x$grub_platform" = xefi ]; then' | sed "s/^/$indent/"
				echo "		set gfxpayload=keep" | sed "s/^/$indent/"
				echo '	fi' | sed "s/^/$indent/"
			fi
		else
			if [ "x$GRUB_GFXPAYLOAD_LINUX" != xtext ]; then
				echo "	load_video" | sed "s/^/$indent/"
			fi
			echo "	set gfxpayload=$GRUB_GFXPAYLOAD_LINUX" | sed "s/^/$indent/"
		fi

		if [ "x$initramfs" != x ]; then
			echo "	insmod chain" | sed "s/^/$indent/" # needed for uki
		else
			echo "	insmod gzio" | sed "s/^/$indent/" # needed for initramfs img
		fi
		### ---

		# TODO: This came from the LLM, I'm not 100% what it does. My current
		# guess (pending testing, the todo) is that it emits the appropriate
		# > insmod ff_type
		# lines necessary for whereever BOOT_DEVICE points.
		# It also looks to emit the "search" directive, thus this is the
		# equivalent placement from the original.
		#
		# Also TODO clean up the grub_add_tab that's some real vibe code shit
		prepare_grub_to_access_device "${BOOT_DEVICE}" | grub_add_tab | \
			while IFS= read -r line;
				do echo "${indent}${line}";
			done

		# TODO: linux line is for regular kernel, chainloader is for UKI
		echo "${indent}${tab}echo 'Loading ${version} -- ${mode} mode'"
		# echo "${indent}${tab}linux  ${rel_kernel} ${rw_flag} root=${root_uuid} ${BASE_CMDLINE} fsmode=${mode}"
		echo "${indent}${tab}chainloader ${rel_dirname}/${basename} root=${root_uuid} ${rw_flag} ${BASE_CMDLINE} fsmode=${mode}"
		if [ "x$initramfs" != x ]; then
			# ^^ skip if kernel is UKI
			echo "${indent}${tab}echo 'Loading initramfs'"
			echo "${indent}${tab}initrd ${rel_initramfs}"
		fi
		echo "${indent}}"
		echo ""
    done
}

# Run once for newest kernel version to appear at the root menu level
generate_boot_entries "$DEFAULT_VERSION" ""

# Generate submenus for every older kernel found
# (NGL: I like the generated logic better than the original for this...)
if [ "${#OLDER_VERSIONS[@]}" -gt 0 ]; then
    echo "submenu 'Previous kernel versions' {"
    # Emit newest to oldest
    for (( i=${#OLDER_VERSIONS[@]}-1; i>=0; i-- )); do
        version="${OLDER_VERSIONS[$i]}"
        echo "  submenu '${version}' {"
		# second param is a tab char
        generate_boot_entries "$version" "	"
        echo "  }"
        echo ""
    done
    echo "}"
fi
